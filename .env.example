# Instagram_Core — Environment Variables
# Copy this file to .env and fill in your credentials

# Instagram account
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_HANDLE=@your_handle

# OpenAI API key (for GPT-4o and DALL-E)
OPENAI_API_KEY=sk-...

# Google Gemini API key (fallback if OpenAI fails)
GEMINI_API_KEY=AIza...

# Logo intro (set to 0 to disable)
LOGO_INTRO_ENABLED=0
